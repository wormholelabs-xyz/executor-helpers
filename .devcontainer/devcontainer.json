  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--sysctl=net.ipv4.conf.all.route_localnet=1"
  ],
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.insertFinalNewline": true,
        "[solidity]": {
          "editor.defaultFormatter": "JuanBlanco.solidity"
        },
        "solidity.formatter": "forge",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.linkedProjects": [
          "svm/relay_cost_protection/Cargo.toml",
          "svm/post-vaa-relay/Cargo.toml"
        ],
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=executor-helpers-cargo-registry-${devcontainerId},target=/home/node/.cargo/registry,type=volume",
    "source=executor-helpers-cargo-git-${devcontainerId},target=/home/node/.cargo/git,type=volume",
    "source=executor-helpers-solana-cache-${devcontainerId},target=/home/node/.cache/solana,type=volume",
    "source=executor-helpers-svm-${devcontainerId},target=/home/node/.svm,type=volume",
    "source=/dev/null,target=/workspace/.env,type=bind,consistency=delegated"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "initializeCommand": "[ -e .env ] || touch .env",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh"
}
